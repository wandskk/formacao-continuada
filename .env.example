# ==========================================
# Variáveis de Ambiente - Template de Exemplo
# ==========================================

# Conexão com PostgreSQL via Pooler (Recomendado para runtime Next.js / Serverless)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/neondb?channel_binding=require&sslmode=require"

# Conexão Direta com PostgreSQL (Obrigatório para Prisma Migrations no Neon)
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require"

# Segredo para autenticação JWT / Sessão
NEXTAUTH_SECRET="substitua_por_um_hash_aleatorio_seguro_min_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
